# =====================================================================
# Job Application Copilot - Environment Configuration (Task 10)
# =====================================================================

# Web Search Configuration (Required for Live Web Research)
TAVILY_API_KEY=

# LLM Provider Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Alternative LLM Provider (Google Gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Active Provider: 'openai' or 'gemini'
LLM_PROVIDER=openai

# Database and Output Paths
MCP_JOBS_PATH=data/jobs.json
APPLICATIONS_DB_PATH=data/applications.db
OUTPUT_DIR=outputs
